FLASK_APP=run.py
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
# Production refuses to start unless SECRET_KEY and JWT_SECRET_KEY are at least
# 32 characters and SECURITY_PASSWORD_SALT at least 16, and none is a placeholder.
# Generate each one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

FLASK_ENV=production
#FLASK_ENV=development

CSRF_SESSION_KEY=CSRF_SESSION_KEY_HERE

JWT_SECRET_KEY=
SECURITY_PASSWORD_SALT=
#DATABASE_URL=mysql+pymysql://username:<db-password>@localhost:3306/invoicer_db
DATABASE_URL="postgresql+psycopg://wayand@localhost:5432/invoicer_db"

UPLOAD_FOLDER="./uploads"

MAIL_SERVER='smtp.mailtrap.io'
MAIL_PORT=2525
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME='user'
MAIL_PASSWORD='pass'
MAIL_DEFAULT_SENDER='postmaster@wayand.dk'
## test

# Rate limiting (in-memory by default: per process, reset on restart)
#RATELIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of gunicorn that append to X-Forwarded-For.
# Leave 0 unless you know it; too high lets clients spoof their IP.
TRUSTED_PROXY_COUNT=0

# Public address of the Vue app, used for links in emails (reset password, confirm email)
SITE_DOMAIN=http://localhost:8080
