{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(cat .env*)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push --set-upstream origin main)",
      "Bash(git push --set-upstream origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push -u origin master)",
      "Bash(git push -u origin master *)",
      "Bash(git push --set-upstream origin master)",
      "Bash(git push --set-upstream origin master *)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:master *)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
